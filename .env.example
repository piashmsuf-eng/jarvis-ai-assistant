# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
# Alternative: GROQ_MODEL=mixtral-8x7b-32768

# Cartesia AI Configuration (Sonic Model for TTS)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=sonic-english
CARTESIA_MODEL_ID=sonic-multilingual-v1
CARTESIA_STREAM_ENDPOINT=wss://api.cartesia.ai/v1/stream

# Letta.ai (MemGPT) Configuration
LETTA_API_KEY=your_letta_api_key_here
LETTA_AGENT_ID=your_agent_id_here
LETTA_USER_ID=default_user
LETTA_API_URL=https://api.letta.ai/v1

# Whisper STT Configuration  
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large-v3
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
# Options: cpu, cuda (if GPU available)

# App Configuration
APP_NAME=Jarvis AI Assistant
DEBUG_MODE=False
LOG_LEVEL=INFO
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024